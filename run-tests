#!/usr/bin/env bash
# Run Luau plugin tests under tests/*.test.luau.
#
# Luau CLI (stdlib only) has no io / os.execute / os.exit / filesystem listing.
# Discovery and the deliberately-failing fixture subprocess live here in bash.
# Multi-file invocation: luau <tests...> tests/support/finish.luau
# so the shared require-cache runner can print "N passed, M failed" once.
#
# Entry scripts cannot be read from disk inside Luau, so this wrapper also
# pre-generates tests/.generated/<sanitized>.src.luau modules (return [==[src]==])
# for plugin-root *.luau, lib/**/*.luau, views/*.luau,
# tests/support/fixtures/**/*.luau (non-test), translations/*.json,
# tests/fixtures/* and plugin.toml.
# modules.load / entry.load require() those modules.
set -euo pipefail

export TZ=America/Sao_Paulo

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

if ! command -v luau >/dev/null 2>&1; then
  echo "luau not found on PATH" >&2
  exit 127
fi

# Write tests/.generated/<sanitized>.src.luau that returns the file source as a string.
# Picks the shortest long-bracket level whose closer is absent from the source.
generate_entry_source() {
  local src_file="$1"
  local rel="${src_file#./}"
  local base="${rel%.luau}"
  base="${base//[\/.]/_}"
  local out="tests/.generated/${base}.src.luau"
  local eqs="" n close open
  for ((n = 0; n <= 20; n++)); do
    close="]${eqs}]"
    if ! grep -Fqe "$close" "$src_file"; then
      open="[${eqs}["
      {
        printf '%s\n' "-- Generated by run-tests from ${rel}; do not edit."
        printf '%s\n' "return ${open}"
        # Ensure a trailing newline so the closer sits on its own line.
        cat "$src_file"
        [[ -n "$(tail -c1 "$src_file" || true)" ]] && printf '\n'
        printf '%s\n' "${close}"
      } >"$out"
      return 0
    fi
    eqs+="="
  done
  echo "run-tests: cannot find a safe long-bracket level for ${rel}" >&2
  return 1
}

generate_all_entry_sources() {
  mkdir -p tests/.generated
  local f
  shopt -s nullglob
  for f in *.luau; do
    generate_entry_source "$f"
  done
  shopt -u nullglob

  while IFS= read -r f; do
    case "$f" in
      *.test.luau) continue ;;
    esac
    generate_entry_source "$f"
  done < <(find lib views tests/support/fixtures -name '*.luau' 2>/dev/null | sort)

  shopt -s nullglob
  for f in translations/*.json tests/fixtures/* plugin.toml; do
    [[ -f "$f" ]] && generate_entry_source "$f"
  done
  shopt -u nullglob
}

EXPECT_FAIL=0
if [[ "${1:-}" == "--expect-fail" ]]; then
  EXPECT_FAIL=1
  shift
fi

generate_all_entry_sources

run_luau_suite() {
  local -a files=("$@")
  if ((${#files[@]} == 0)); then
    echo "0 passed, 0 failed"
    return 0
  fi
  luau "${files[@]}" tests/support/finish.luau
}

if ((EXPECT_FAIL)); then
  if (($# == 0)); then
    echo "run-tests --expect-fail requires a test file" >&2
    exit 2
  fi
  set +e
  output="$(run_luau_suite "$@" 2>&1)"
  code=$?
  set -e
  printf '%s\n' "$output"
  if ((code != 0)); then
    exit 0
  fi
  echo "expected failure but suite passed" >&2
  exit 1
fi

shopt -s nullglob
if (($# > 0)); then
  test_files=("$@")
else
  test_files=(tests/*.test.luau)
fi

set +e
suite_output="$(run_luau_suite "${test_files[@]}" 2>&1)"
suite_code=$?
set -e
printf '%s\n' "$suite_output"

# Subprocess check: fixture must fail (exit 1 from luau -> --expect-fail exits 0).
fixture="tests/support/fixtures/failing.test.luau"
if [[ -f "$fixture" ]]; then
  set +e
  fixture_output="$(bash "$ROOT/run-tests" --expect-fail "$fixture" 2>&1)"
  fixture_code=$?
  set -e
  if ((fixture_code != 0)); then
    echo "selftest fixture: --expect-fail did not confirm failure" >&2
    printf '%s\n' "$fixture_output" >&2
    exit 1
  fi
fi

sh_code=0
if (($# == 0)); then
  for t in tests/*.test.sh; do
    bash "$t" || sh_code=1
  done
fi

((suite_code != 0)) && exit "$suite_code"
exit "$sh_code"
