local assert = require("./support/assert")
local runner = require("./support/runner")
local modules = require("./support/modules")

local describe, it = runner.describe, runner.it
local WriteQueue = modules.load("lib/writequeue.luau")

describe("write queue", function()
	it("starts the first job right away and queues the rest", function()
		local q = WriteQueue.createQueue()
		local a = WriteQueue.enqueue(q, "A")
		assert.same(a.start, { token = 1, payload = "A" })
		local b = WriteQueue.enqueue(a.queue, "B")
		assert.equal(b.start, nil)
		q = b.queue
		local s = WriteQueue.settle(q, 1)
		assert.same(s.settled, { token = 1, payload = "A" })
		assert.same(s.start, { token = 2, payload = "B" })
		local done = WriteQueue.settle(s.queue, 2)
		assert.equal(done.start, nil)
		assert.equal(done.queue.active, nil)
		assert.same(done.queue.pending, {})
	end)

	it("settles a job only once, so a late duplicate signal cannot skip the next job", function()
		local a = WriteQueue.enqueue(WriteQueue.createQueue(), "A")
		local b = WriteQueue.enqueue(a.queue, "B")
		local first = WriteQueue.settle(b.queue, 1)
		local again = WriteQueue.settle(first.queue, 1)
		assert.equal(again.settled, nil)
		assert.equal(again.start, nil)
		assert.same(again.queue, first.queue)
	end)

	it("ignores settle on an idle queue", function()
		local q = WriteQueue.createQueue()
		local r = WriteQueue.settle(q, 1)
		assert.equal(r.queue, q)
		assert.equal(r.settled, nil)
	end)

	it("does not mutate the previous queue state", function()
		local a = WriteQueue.enqueue(WriteQueue.createQueue(), "A")
		WriteQueue.enqueue(a.queue, "B")
		assert.same(a.queue.pending, {})
	end)
end)

describe("sync coalescing", function()
	it("starts a sync when idle", function()
		assert.same(WriteQueue.requestSync(WriteQueue.createSync()), { state = { running = true, pending = false }, start = true })
	end)

	it("remembers a request made while a sync runs and reruns once afterwards", function()
		local r = WriteQueue.requestSync(WriteQueue.createSync())
		r = WriteQueue.requestSync(r.state)
		assert.same(r, { state = { running = true, pending = true }, start = false })
		r = WriteQueue.requestSync(r.state)
		assert.equal(r.state.pending, true)
		local f = WriteQueue.syncFinished(r.state)
		assert.same(f, { state = { running = true, pending = false }, start = true })
		assert.same(WriteQueue.syncFinished(f.state), { state = { running = false, pending = false }, start = false })
	end)
end)
