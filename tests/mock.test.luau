local assert = require("./support/assert")
local runner = require("./support/runner")
local mock = require("./support/noctalia_mock")
local describe, it = runner.describe, runner.it

describe("mock", function()
	it("defers runAsync answers when deferAsync is set", function()
		local env = mock.new({ deferAsync = true })
		local got
		env.noctalia.runAsync({ "khal", "printcalendars" }, function(r) got = r end)
		assert.equal(got, nil)
		assert.equal(#mock.pendingAsync(env), 1)
		mock.resolveAsync(env, 1, { exitCode = 0, stdout = "Eventos\n", stderr = "" })
		assert.equal(got.stdout, "Eventos\n")
		assert.equal(#mock.pendingAsync(env), 0)
	end)

	it("answers commandExists from opts.commands", function()
		local env = mock.new({ commands = { khal = true } })
		assert.equal(env.noctalia.commandExists("khal"), true)
		assert.equal(env.noctalia.commandExists("vdirsyncer"), false)
	end)

	it("renames and lists files in the fake fs", function()
		local env = mock.new({ fs = { ["/d/a.tmp"] = "x", ["/d"] = true } })
		assert.equal((env.noctalia.renameFile("/d/a.tmp", "/d/a")), true)
		assert.equal(env.noctalia.readFile("/d/a"), "x")
		assert.same(env.noctalia.listDir("/d"), { "a" })
	end)

	it("moves the clock with mock.advance", function()
		local env = mock.new({ now = 1000 })
		mock.advance(env, 500)
		assert.equal(env.noctalia.nowMs(), 1500)
	end)

	it("returns the scripted clipboard", function()
		local env = mock.new({ clipboard = "https://x.dev" })
		assert.equal(env.noctalia.clipboardText(), "https://x.dev")
	end)

	it("records sound loads and resolves them", function()
		local env = mock.new({})
		local ok
		assert.equal(env.noctalia.sound.load("alarm", "alarm.mp3", function(o) ok = o end), true)
		mock.resolveSound(env, 1, true)
		assert.equal(ok, true)
		env.noctalia.sound.play("alarm")
		assert.equal(#mock.calls(env, "noctalia.sound.play"), 1)
	end)

	it("resolves http and download calls", function()
		local env = mock.new({})
		local res, dl
		env.noctalia.http({ url = "https://x.dev" }, function(r) res = r end)
		env.noctalia.download("https://x.dev/i.png", "/t/1", function(ok) dl = ok end)
		mock.resolveHttp(env, 1, { ok = true, status = 200, body = "<html>" })
		mock.resolveDownload(env, 1, true)
		assert.equal(res.body, "<html>")
		assert.equal(dl, true)
	end)

	it("exposes panel and desktopWidget recorders", function()
		local env = mock.new({})
		env.panel.render({ type = "column" })
		env.panel.setWantsSecondTicks(true)
		env.desktopWidget.render({ type = "column" })
		assert.equal(#mock.calls(env, "panel.render"), 1)
		assert.equal(#mock.calls(env, "desktopWidget.render"), 1)
	end)
end)
