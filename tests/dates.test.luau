local assert = require("./support/assert")
local runner = require("./support/runner")
local modules = require("./support/modules")

local describe, it = runner.describe, runner.it
local Dates = modules.load("lib/dates.luau")

describe("dates", function()
	it("pads to two digits", function()
		assert.equal(Dates.pad2(3), "03")
		assert.equal(Dates.pad2(12), "12")
	end)

	it("formats and parses local ISO dates", function()
		local late = Dates.toDate("2026-10-09", "23:59")
		assert.equal(Dates.isoDate(late), "2026-10-09")
		assert.equal(Dates.isoDate(Dates.parseIsoDate("2026-02-28")), "2026-02-28")
		assert.equal(Dates.parseIsoDate("2026-13-01"), nil)
		assert.equal(Dates.parseIsoDate("nope"), nil)
	end)

	it("adds days across month and year boundaries", function()
		local oct31 = Dates.parseIsoDate("2026-10-31")
		local dec31 = Dates.parseIsoDate("2026-12-31")
		local oct1 = Dates.parseIsoDate("2026-10-01")
		assert.equal(Dates.isoDate(Dates.addDays(oct31, 1)), "2026-11-01")
		assert.equal(Dates.isoDate(Dates.addDays(dec31, 1)), "2027-01-01")
		assert.equal(Dates.isoDate(Dates.addDays(oct1, -3)), "2026-09-28")
	end)

	it("formats and parses HH:MM", function()
		local t = Dates.toDate("2026-01-01", "09:05")
		assert.equal(Dates.hhmm(t), "09:05")
		assert.equal(Dates.minutesOf("15:30"), 930)
		assert.equal(Dates.minutesOf("9:30"), nil)
	end)

	it("adds minutes rolling over midnight", function()
		assert.same(Dates.addMinutes("2026-10-09", "23:30", 60), { date = "2026-10-10", time = "00:30" })
		assert.same(Dates.addMinutes("2026-10-09", "15:00", 15), { date = "2026-10-09", time = "15:15" })
	end)

	it("builds a local epoch from date and time", function()
		local withTime = Dates.toDate("2026-10-09", "15:30")
		local midnight = Dates.toDate("2026-10-09", nil)
		assert.equal(Dates.isoDate(withTime), "2026-10-09")
		assert.equal(Dates.hhmm(withTime), "15:30")
		assert.equal(Dates.isoDate(midnight), "2026-10-09")
		assert.equal(Dates.hhmm(midnight), "00:00")
	end)

	it("adds days across a month end in local time", function()
		local t = Dates.parseIsoDate("2026-10-31")
		assert.equal(Dates.isoDate(Dates.addDays(t, 1)), "2026-11-01")
	end)

	it("rejects impossible dates", function()
		assert.equal(Dates.parseIsoDate("2026-02-30"), nil)
	end)

	it("adds minutes across midnight", function()
		assert.same(Dates.addMinutes("2026-10-15", "23:50", 15), { date = "2026-10-16", time = "00:05" })
	end)

	it("converts epoch milliseconds to seconds", function()
		assert.equal(Dates.nowSeconds(1500), 1.5)
		assert.equal(Dates.nowSeconds(0), 0)
	end)

	it("parses 1970-01-01 without raising", function()
		local t = Dates.parseIsoDate("1970-01-01")
		assert.equal(typeof(t), "number")
		assert.equal(Dates.isoDate(t :: number), "1970-01-01")
	end)

	it("rejects pre-epoch dates without raising", function()
		assert.equal(Dates.parseIsoDate("1969-12-31"), nil)
	end)
end)
